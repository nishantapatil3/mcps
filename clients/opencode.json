{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "web-tools": {
            "enabled": true,
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "git+https://github.com/nishantapatil3/mcps#subdirectory=web-tools",
                "web-tools"
            ],
            "timeout": 30000
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        },
        "youtube-transcript": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "git+https://github.com/jkawamoto/mcp-youtube-transcript",
                "mcp-youtube-transcript",
                "--response-limit",
                "15000"
            ],
            "enabled": true
        }
    }
}
